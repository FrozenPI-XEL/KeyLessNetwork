{
  "expo": {
    "name": "KeyLessNetwork",
    "slug": "keylessnetwork",
    "scheme": "keylessnetwork",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.frozenpixel.keylessnetwork",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Die App verbindet sich mit deinen Schränken (Raspberry Pi) im lokalen Netzwerk.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.frozenpixel.keylessnetwork"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "./plugins/withKlnCa"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c1cb70c0-0079-417d-9e36-29430b6b567d"
      }
    },
    "owner": "leon_ayvazian"
  }
}
