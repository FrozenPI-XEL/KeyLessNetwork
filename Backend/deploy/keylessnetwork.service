# systemd-Dienst: startet den Locker-Server automatisch nach jedem Neustart des Pi.
# Einrichten: siehe deploy/install-service.sh (einmal auf dem Pi ausführen).
[Unit]
Description=KeyLessNetwork Locker-Server
# Der Pi braucht Internet (Supabase) und eine korrekte Uhrzeit (Signaturen), bevor er startet.
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=simple
# Die LED-Leiste (NeoPixel an GPIO18) braucht auf vielen Pi-Modellen root-Rechte. Startest du bisher
# mit "sudo uvicorn ...", hier "User=root" eintragen.
User=pi
WorkingDirectory=/home/pi/projects
ExecStart=/usr/bin/python3 /home/pi/projects/main.py
# TLS ist Pflicht: Zertifikat liegt in /home/pi/projects/certs/server.crt und server.key
# (erzeugt mit deploy/make-certs.sh). Ohne Zertifikat startet der Server nicht.
# Optionale Einstellungen in /home/pi/projects/kln.env, z. B.
#   KLN_MOTOR_SECONDS=2          Motorlaufzeit in Sekunden (Standard 0.1, auf der Hardware prüfen)
#   KLN_TLS_CERT=/anderer/pfad/server.crt
#   KLN_TLS_KEY=/anderer/pfad/server.key
EnvironmentFile=-/home/pi/projects/kln.env
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
# Beim Stoppen SIGTERM schicken: main.py fährt dann die Motoren herunter und gibt die GPIOs frei.
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
